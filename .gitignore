# Environment file with credentials
.env

# Container configuration directories (generated at runtime)
config/firefox/
config/qbittorrent/

# Gluetun config contains API key
config/gluetun/config.toml

# Gluetun's VPN server list: runtime data it rewrites on start (v3.42+ keeps it in servers/)
config/gluetun/servers.json
config/gluetun/servers/

# Watch folder contents
watch/*.torrent

# OS-specific files
.DS_Store
**/.DS_Store
Thumbs.db
Desktop.ini

# IDE files
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log

# Python bytecode caches (created by running the tests)
__pycache__/

# Local working notes and reports (may contain secrets)
docs/
