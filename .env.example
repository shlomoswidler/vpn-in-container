# ===========================================
# Docker Compose Project Name
# ===========================================
# REQUIRED: Prevents Docker Compose from normalizing hyphens to underscores
# in relative volume mount paths. Without this, ./config/* mounts resolve to
# the wrong directory and containers start with empty configurations.

COMPOSE_PROJECT_NAME=vpn-in-container

# ===========================================
# ProtonVPN WireGuard Configuration
# ===========================================
# Generate WireGuard config at: https://account.proton.me/u/0/vpn/WireGuard
# IMPORTANT: Enable "NAT-PMP (Port Forwarding)" when generating config
# Copy the PrivateKey value from the generated .conf file

WIREGUARD_PRIVATE_KEY=your_wireguard_private_key_here

# ===========================================
# Server Selection
# ===========================================
# Use country names, comma-separated for multiple options
# Examples: Netherlands, Switzerland, Sweden, Japan

SERVER_COUNTRIES=Netherlands

# ===========================================
# Gluetun Control Server API Key
# ===========================================
# Generate with: openssl rand -hex 32
# Used by qSticky to query port forwarding status. The only copy of the key:
# Compose writes Gluetun's auth file from it (configs: gluetun_auth in
# docker-compose.yml). It goes into a TOML string, so it must not contain
# " or \. After changing it, run
# docker compose up -d --force-recreate vpn qsticky, then docker compose up -d
# (README.md, Changing the API Key).

GLUETUN_API_KEY=your_random_api_key_here

# ===========================================
# qBittorrent Password for qSticky (optional)
# ===========================================
# This does NOT set qBittorrent's password: it is only what qSticky sends when it
# logs in to qBittorrent (user admin). qSticky connects over loopback, where
# qBittorrent does not check the password (the init script sets
# LocalHostAuth=false), so leave it unset. Set it to your WebUI password only if
# you turn that off: qBittorrent bans 127.0.0.1 for an hour after 5 wrong logins.

# QBITTORRENT_PASS=

# ===========================================
# User/Group IDs
# ===========================================
# REQUIRED: your user and group IDs, so downloads belong to you.
# Put the output of 'id -u' in PUID and of 'id -g' in PGID (./start.sh fills
# them in itself when they are empty).
# Comments must stay on their own lines: Compose would read a comment after
# "PUID=" as the value.

PUID=
PGID=

# ===========================================
# Timezone
# ===========================================
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones

TZ=America/New_York

# ===========================================
# Download Path
# ===========================================
# Where torrents are saved on your host; Firefox downloads (and .torrent files
# for qBittorrent) go to its downloads/ subfolder. Optional: unset, it is
# ${HOME}/Downloads/vpn-in-container (the default in docker-compose.yml).
# ${HOME} works here (Compose interpolates unquoted and double-quoted values);
# ~ does not.

# DOWNLOADS_PATH=${HOME}/Downloads/vpn-in-container
